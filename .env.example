# Copy to .env.local for local development against a real Supabase project.
# Leave both empty (or delete the file) to run the site in demo mode.
#
# Project URL: Supabase Dashboard -> Project Settings -> Data API (or "Connect")
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...): Project Settings -> API Keys.
# This key is meant to be public; Row Level Security protects the data.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Older projects can use the legacy anon key instead (fallback name):
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
